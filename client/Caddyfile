{
    admin off
    auto_https off
}

:80 {
    encode gzip zstd

    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-XSS-Protection "1; mode=block"
        # Prevent caching of the SPA entry point so users always get the latest app
        Cache-Control "no-cache, no-store, must-revalidate" /index.html
        # Cache static assets aggressively (they have content hashes in filenames)
        Cache-Control "public, max-age=31536000, immutable" /assets/*
        -Server
    }

    # Proxy API requests to the backend container
    handle /api/* {
        reverse_proxy server:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up Host {host}
        }
    }

    # Health check endpoint (also proxied to backend)
    handle /health {
        reverse_proxy server:3000
    }

    # Serve the React SPA — fall back to /index.html for client-side routing
    root * /srv
    file_server
    try_files {path} /index.html
}
