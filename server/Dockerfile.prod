FROM oven/bun:latest AS builder

WORKDIR /app

COPY package.json bun.lock ./

# Copy ALL workspaces
COPY server/ ./server/
COPY client/ ./client/
COPY packages/ ./packages/

RUN bun install --frozen-lockfile

# Generate Prisma client for the correct binary target
WORKDIR /app/server
RUN bunx prisma generate

# ---- Runtime image ----
# Use Bun Alpine for a slim image — interpreted mode avoids bundling issues
# with Prisma's @prisma/adapter-pg and its native pg driver
FROM oven/bun:alpine

WORKDIR /app

COPY --from=builder /app/package.json ./
COPY --from=builder /app/bun.lock ./
COPY --from=builder /app/server ./server
COPY --from=builder /app/packages ./packages

WORKDIR /app/server

# Production-only install (no devDependencies)
RUN bun install --frozen-lockfile --production

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["bun", "run", "index.ts"]
