FROM oven/bun:latest

WORKDIR /app

COPY package.json bun.lock ./

COPY server/ ./server/
COPY packages/ ./packages/

RUN bun install

WORKDIR /app/server

RUN bunx prisma generate

# Run migrations against the test DB then execute the test suite
CMD ["sh", "-c", "bunx prisma migrate deploy && bun test src/__tests__/**/*.test.ts --reporter=spec"]
